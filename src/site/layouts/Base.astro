---
import "../styles/global.css";
import Icon from "../components/Icon.astro";
import { AD_PREFIX, TAG_PREFIX } from "../lib/saved.ts";
import { THEME_KEY } from "../lib/theme.ts";

export const REPO = "https://github.com/omznc/aukcije";

interface Props {
    title: string;
    description?: string;
    /**
     * Absolute-from-root path to this page's share image. Listing pages point at
     * their own; everything else falls back to the one static card.
     */
    image?: string;
}
const {
    title,
    description = "Pretraživi indeks sudskih prodaja (licitacija) u Bosni i Hercegovini - nekretnine, vozila, tehnika i oprema.",
    image = "/og/default.png",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(image, Astro.site).href;
const path = Astro.url.pathname;

/**
 * One icon per destination, so the same page is marked the same way in the
 * header and in the footer. The endpoints at the end are not pages and keep
 * their own icons rather than borrowing one.
 */
const nav = {
    now: { href: "/", label: "Aktuelne", icon: "clock-countdown" },
    drops: { href: "/snizenja/", label: "Sniženo", icon: "trend-down" },
    items: { href: "/predmeti/", label: "Šta se prodaje", icon: "tag" },
    courts: { href: "/sudovi/", label: "Sudovi", icon: "bank" },
    map: { href: "/mapa/", label: "Mapa", icon: "map-trifold" },
    archive: { href: "/arhiva/", label: "Arhiva", icon: "archive" },
    prices: { href: "/cijene/", label: "Cijene", icon: "chart-bar" },
    search: { href: "/pretraga/", label: "Pretraga", icon: "magnifying-glass" },
    guide: {
        href: "/kako-se-nadmetati/",
        label: "Kako se nadmetati",
        icon: "book-open-text",
    },
    // Only this entry has anything behind it that the build cannot see, so it is
    // the only one that carries a count filled in by the browser.
    saved: {
        href: "/sacuvano/",
        label: "Sačuvano",
        icon: "bookmark-simple",
        counted: true,
    },
};

const tabs = Object.values(nav);

const footerColumns = [
    [nav.now, nav.drops, nav.items, nav.courts],
    [nav.map, nav.archive, nav.prices, nav.search, nav.saved],
    [
        nav.guide,
        { href: "/privatnost/", label: "Privatnost", icon: "shield-check" },
        { href: "/rss.xml", label: "RSS", icon: "rss-simple", accent: true },
        {
            href: "/kalendar.ics",
            label: "Kalendar (.ics)",
            icon: "calendar-plus",
        },
        { href: "/podaci.json", label: "JSON dataset", icon: "database" },
        { href: REPO, label: "Izvorni kod", icon: "github-logo" },
    ],
];

/** The listing and category pages live under their section's nav entry. */
const isActive = (href: string) =>
    href === "/" ? path === "/" : path.startsWith(href);
---

<!doctype html>
<html lang="bs" class="h-full">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <!--
          Both sheets exist, so the browser is told both are on offer. This is
          what it paints its own canvas with in the moment between one page
          leaving and the next one drawing - the window Firefox otherwise shows
          as a flash on every navigation - and it is read before the stylesheet
          has arrived, which is why it is a meta and not a declaration.

          It resolves to the system's preference, which is right for everyone
          who has not overridden it and briefly wrong for everyone who has: the
          only lever available this early is this one, and it cannot see
          localStorage. The script below closes that gap as soon as there is a
          document to close it on.
        -->
        <meta name="color-scheme" content="light dark" />
        <!--
          The visitor's own choice of sheet, applied before anything is painted.
          Inline, un-bundled and first in the head on purpose: a module would be
          deferred until after the first paint, and the paint it would come after
          is the one drawn in the wrong palette. Every page here is its own
          document, so that flash would be on every navigation rather than once.

          `data-themeable` is what the header's toggle is shown by. Both halves
          have to hold for it to be worth showing: a browser that can resolve
          the `light-dark()` palette in global.css, and this script having run to
          write the choice down. Neither is true of the fallback path, and a
          control that cannot do anything is worse than no control.
        -->
        <script is:inline define:vars={{ themeKey: THEME_KEY }}>
            (function () {
                if (
                    !window.CSS ||
                    !CSS.supports ||
                    !CSS.supports("color", "light-dark(#fff, #000)")
                )
                    return;
                var root = document.documentElement;
                root.dataset.themeable = "";
                var stored = null;
                try {
                    stored = localStorage.getItem(themeKey);
                } catch (e) {
                    // Storage can be blocked outright, in which case the sheet
                    // simply follows the system, as a first visit does.
                }
                if (stored !== "light" && stored !== "dark") stored = null;
                // Left empty when there is no choice, so the stylesheet's
                // `color-scheme: light dark` keeps tracking the system.
                root.style.colorScheme = stored || "";
                root.dataset.theme =
                    stored ||
                    (matchMedia("(prefers-color-scheme: dark)").matches
                        ? "dark"
                        : "light");
            })();
        </script>
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Sudske prodaje BiH" />
        <meta property="og:locale" content="bs_BA" />
        <!--
          These notices circulate by being pasted into a chat, so the card is
          the first thing most people see of a listing. Every page has one.
        -->
        <meta property="og:image" content={shareImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={shareImage} />
        <link
            rel="alternate"
            type="application/rss+xml"
            title="Nove sudske prodaje"
            href="/rss.xml"
        />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <!--
          The faces themselves are declared in global.css and served from here;
          see the note there for why they are not fetched from Google. These
          two are the ones every page is set in - the body and the mono that
          carries every figure and label - and without a preload the browser
          only learns it needs them once it has parsed the stylesheet that
          mentions them. Asking for them alongside that stylesheet instead
          means the text is set right on the first paint rather than one swap
          later. The other four faces are the accented and serif cuts, which
          are worth discovering the ordinary way.
        -->
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/instrument-sans-latin.woff2"
            crossorigin
        />
        <link
            rel="preload"
            as="font"
            type="font/woff2"
            href="/fonts/jetbrains-mono-latin.woff2"
            crossorigin
        />
    </head>
    <body class="min-h-full bg-paper font-sans text-ink antialiased">
        <div
            class="mx-auto min-h-screen max-w-[1180px] border-rule bg-sheet sm:border-x"
        >
            <header>
                <!-- Same band as the tab strip below it, so the header reads as one block. -->
                <div
                    class="gut flex flex-wrap items-center justify-between gap-x-3.5 gap-y-1.5 bg-band pb-3 pt-3.5"
                >
                    <div class="flex items-baseline gap-3.5">
                        <a
                            href="/"
                            class="font-mono text-[0.9375rem] font-bold leading-none tracking-tight text-ink"
                        >
                            SUDSKE PRODAJE
                        </a>
                        <span
                            class="hidden font-mono text-[0.625rem] leading-none text-dim sm:inline"
                        >
                            NEZAVISNI INDEKS · NIJE SLUŽBENI IZVOR
                        </span>
                    </div>
                    <div class="flex items-center gap-4">
                        <!--
                          Hidden until the head script has said the browser can
                          honour it; see the note there. The two labels sit in
                          one grid cell and cross-fade, which is what keeps the
                          header from reflowing when the wider of them arrives.
                        -->
                        <button
                            type="button"
                            data-theme-toggle
                            aria-pressed="false"
                            aria-label="Tamni prikaz"
                            class="theme-toggle press press-give items-center font-mono text-[0.6875rem] font-medium leading-none text-ink-mid hover:text-ink"
                        >
                            <span class="swap">
                                <span
                                    data-idle
                                    class="flex items-center gap-1.5"
                                >
                                    <Icon name="moon" size={14} />
                                    TAMNO
                                </span>
                                <span
                                    data-done
                                    class="flex items-center gap-1.5"
                                >
                                    <Icon name="sun" size={14} />
                                    SVIJETLO
                                </span>
                            </span>
                        </button>
                        <a
                            href="/rss.xml"
                            class="press press-give flex items-center gap-1.5 font-mono text-[0.6875rem] font-medium leading-none text-rust"
                        >
                            <Icon name="rss-simple" size={14} />
                            RSS
                        </a>
                    </div>
                </div>

                <!--
                  Which way the toggle is already pointing, written while the
                  header is still being parsed rather than by the module at the
                  foot of the page - the same reason as the saved counter below,
                  and the same shape of fix. The head script has resolved the
                  theme by now; this only reflects it onto the control.
                -->
                <script is:inline>
                    if (document.documentElement.dataset.theme === "dark") {
                        var toggle = document.querySelector(
                            "[data-theme-toggle]",
                        );
                        if (toggle) toggle.setAttribute("aria-pressed", "true");
                    }
                </script>

                <!--
                  Tabs, drawn like a browser's: the strip sits on the tinted band
                  and the active tab is a notch of the sheet below, so the two
                  read as one surface. The rule under the strip is an inset shadow
                  rather than a border, which lets the active tab's own background
                  paint over it without a negative margin fighting the scroll box.
                -->
                <nav
                    id="tabs"
                    class="gut flex gap-1 overflow-x-auto bg-band pt-2 shadow-[inset_0_-1px_0_var(--c-rule)] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
                >
                    {
                        tabs.map((item) => (
                            <a
                                href={item.href}
                                aria-current={
                                    isActive(item.href) ? "page" : undefined
                                }
                                class:list={[
                                    "press flex shrink-0 items-center gap-1.5 whitespace-nowrap border border-b-0 px-3 pb-[9px] pt-2 text-[0.78125rem] leading-none",
                                    isActive(item.href)
                                        ? "border-rule bg-sheet font-semibold text-ink"
                                        : "border-transparent text-ink-mid hover:bg-band-wash hover:text-ink active:bg-band-wash-deep active:text-ink",
                                ]}
                            >
                                <Icon
                                    name={item.icon}
                                    size={15}
                                    class={
                                        isActive(item.href)
                                            ? "text-pine"
                                            : "text-dim"
                                    }
                                />
                                {item.label}
                                {item.counted && (
                                    <span
                                        data-saved-count
                                        hidden
                                        class="ml-0.5 border border-pine px-1 py-px font-mono text-[0.59375rem] font-bold leading-none text-pine"
                                    />
                                )}
                            </a>
                        ))
                    }
                </nav>

                <!--
                  The badge is the one thing in the header only this browser
                  knows, so it ships empty and hidden. Filling it from the module
                  below would pop it into the strip a frame after the header has
                  already been painted - on every page, since each one is its own
                  document. This runs while the header is still being parsed
                  instead, so the tab is drawn its final width the first time.
                  Inline and un-bundled on purpose: a module would be deferred,
                  which is exactly the delay being avoided.
                -->
                <script
                    is:inline
                    define:vars={{ adPrefix: AD_PREFIX, tagPrefix: TAG_PREFIX }}
                >
                    try {
                        var total = 0;
                        for (var i = 0; i < localStorage.length; i++) {
                            var key = localStorage.key(i);
                            if (
                                key &&
                                (key.indexOf(adPrefix) === 0 ||
                                    key.indexOf(tagPrefix) === 0)
                            )
                                total++;
                        }
                        if (total > 0) {
                            var badges = document.querySelectorAll(
                                "[data-saved-count]",
                            );
                            for (var b = 0; b < badges.length; b++) {
                                badges[b].textContent = String(total);
                                badges[b].hidden = false;
                                // Tells refreshSavedCount the badge is already
                                // filled, so it stays silent rather than
                                // treating this as an arrival worth animating.
                                badges[b].dataset.filled = "";
                            }
                        }
                    } catch (e) {
                        // Storage can be blocked outright; the badge then simply
                        // stays hidden, exactly as it ships.
                    }
                </script>
            </header>

            <main><slot /></main>

            <footer
                class="gut flex flex-wrap justify-between gap-8 border-t border-rule pb-[30px] pt-[26px]"
            >
                <div class="max-w-[56ch]">
                    <div class="font-mono text-[0.75rem] font-bold leading-none">
                        SUDSKE PRODAJE
                    </div>
                    <p class="mt-2.5 text-[0.75rem] leading-relaxed text-muted">
                        Nezavisni indeks oglasa o sudskim prodajama u BiH.
                        Podaci se preuzimaju sa pravosudje.ba dva puta dnevno i
                        obrađuju automatski. Mjerodavan je isključivo zaključak
                        suda. Nema računa, kolačića ni praćenja.
                    </p>
                    <!--
                      The scraper, the extraction rules and the redaction pass
                      are all in the open. For a site that republishes court
                      documents with names taken out, "how" is a fair question
                      to ask, and the answer should not need asking for.
                    -->
                    <p class="mt-3 flex flex-wrap gap-x-4 gap-y-2 font-mono text-[0.6875rem] leading-none text-dim">
                        <a
                            href="https://omarzunic.com"
                            rel="author"
                            class="inline-flex items-center gap-1.5 text-pine"
                        >
                            <Icon name="globe-hemisphere-west" size={14} />
                            OMARZUNIC.COM
                        </a>
                        <a
                            href={REPO}
                            rel="noopener"
                            target="_blank"
                            class="inline-flex items-center gap-1.5 hover:text-ink"
                        >
                            <Icon name="github-logo" size={14} />
                            IZVORNI KOD NA GITHUBU
                        </a>
                    </p>
                </div>
                <div
                    class="flex gap-10 text-[0.78125rem] leading-[1.9] text-ink-mid"
                >
                    {
                        footerColumns.map((column) => (
                            <div class="flex flex-col">
                                {column.map((item) => (
                                    <a
                                        href={item.href}
                                        rel={
                                            item.href.startsWith("http")
                                                ? "noopener"
                                                : undefined
                                        }
                                        target={
                                            item.href.startsWith("http")
                                                ? "_blank"
                                                : undefined
                                        }
                                        class:list={[
                                            "press flex items-center gap-2",
                                            item.accent && "text-rust",
                                        ]}
                                    >
                                        <Icon
                                            name={item.icon}
                                            size={14}
                                            class={
                                                item.accent ? "" : "text-faint"
                                            }
                                        />
                                        {item.label}
                                    </a>
                                ))}
                            </div>
                        ))
                    }
                </div>
            </footer>
        </div>

        <script>
            import { refreshSavedCount } from "../lib/saved-count.ts";
            import { wireThemeToggle } from "../lib/theme.ts";

            wireThemeToggle();
            refreshSavedCount();
            // Saving in one tab should show up in the others; `storage` only fires on
            // the tabs that did not make the change, which is exactly the gap here.
            addEventListener("storage", refreshSavedCount);

            // Which side of the tab strip still has tabs behind it. The stylesheet
            // turns this into an edge fade; see #tabs below.
            const tabs = document.getElementById("tabs");
            if (tabs) {
                const update = () => {
                    const before = tabs.scrollLeft > 4;
                    const after =
                        tabs.scrollLeft + tabs.clientWidth <
                        tabs.scrollWidth - 4;
                    tabs.dataset.overflow =
                        before && after
                            ? "both"
                            : before
                              ? "left"
                              : after
                                ? "right"
                                : "none";
                };
                tabs.addEventListener("scroll", update, { passive: true });
                addEventListener("resize", update);
                update();
                // The active tab is often off-screen on a phone; bring it into view.
                tabs.querySelector('[aria-current="page"]')?.scrollIntoView({
                    inline: "center",
                    block: "nearest",
                });
            }
        </script>

        <style is:global>
            /*
        The sheet's horizontal gutter. It repeats on every band, header and table
        row, so it lives here once rather than as a pair of classes on each.
      */
            .gut {
                padding-left: 20px;
                padding-right: 20px;
            }
            @media (min-width: 768px) {
                .gut {
                    padding-left: 30px;
                    padding-right: 30px;
                }
            }
            a {
                color: inherit;
                text-decoration: none;
            }

            /*
        On a narrow screen the tab strip scrolls, and a strip cut off flush with
        the edge reads as the end of the list. Fading whichever side still has
        tabs behind it says there is more, without spending room on arrows. The
        attribute is set by the script above; with no JS the strip simply never
        fades.
      */
            #tabs[data-overflow="right"] {
                -webkit-mask-image: linear-gradient(
                    to right,
                    #000 calc(100% - 36px),
                    transparent
                );
                mask-image: linear-gradient(
                    to right,
                    #000 calc(100% - 36px),
                    transparent
                );
            }
            #tabs[data-overflow="left"] {
                -webkit-mask-image: linear-gradient(
                    to right,
                    transparent,
                    #000 36px
                );
                mask-image: linear-gradient(to right, transparent, #000 36px);
            }
            #tabs[data-overflow="both"] {
                -webkit-mask-image: linear-gradient(
                    to right,
                    transparent,
                    #000 36px,
                    #000 calc(100% - 36px),
                    transparent
                );
                mask-image: linear-gradient(
                    to right,
                    transparent,
                    #000 36px,
                    #000 calc(100% - 36px),
                    transparent
                );
            }
            footer a:hover,
            nav a:hover {
                color: var(--c-ink);
            }
        </style>
    </body>
</html>
