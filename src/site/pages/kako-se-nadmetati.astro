---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import {
  entitySlices,
  methodSlices,
  roundSlices,
  medianDiscount,
  viewingShare,
  formatPercent,
} from '../lib/stats.ts';

const entities = entitySlices();
const methods = methodSlices();
const thirdRound = roundSlices().find((r) => r.key === 'trece')?.count ?? 0;
const ENTITY_NAMES: Record<string, string> = {
  FBiH: 'FBiH',
  RS: 'RS',
  BD: 'Brčko distrikt',
};

const steps = [
  {
    icon: 'file-text',
    title: 'Pročitajte zaključak suda, ne naš sažetak',
    body: 'U zaključku su početna cijena, kapara, mjesto i vrijeme, te uslovi prodaje. Naši podaci su izvučeni automatski i mogu sadržavati greške.',
  },
  {
    icon: 'hand-coins',
    title: 'Uplatite kaparu na vrijeme',
    body: 'Osiguranje je obično 10% procijenjene vrijednosti i uplaćuje se prije ročišta na račun naveden u zaključku. Bez dokaza o uplati ne možete učestvovati.',
  },
  {
    icon: 'hourglass-medium',
    title: 'Znajte koje je ročište po redu',
    body: `Na prvom ročištu cijena je najviša. Ako prodaja ne uspije, na drugom ročištu početna cijena je niža - u našim podacima medijalno ${
      medianDiscount === null ? 'osjetno' : formatPercent(medianDiscount)
    } u odnosu na procijenjenu vrijednost. Treće ročište je rjeđe, ${thirdRound} slučajeva u arhivi.`,
  },
  {
    icon: 'eye',
    title: 'Pregledajte predmet ako je moguće',
    body: `Samo ${Math.round(viewingShare * 100)}% oglasa navodi termin pregleda. Prodaja je „viđeno-kupljeno”: nema garancije, nema povrata, a stvar može biti u lošijem stanju nego u opisu.`,
  },
  {
    icon: 'map-trifold',
    title: 'Provjerite šta kupujete kod nekretnina',
    body: 'Zemljišnoknjižni izvadak i katastarski podaci pokazuju terete, služnosti i stvarno stanje parcele. Nekretnina može biti useljena.',
  },
  {
    icon: 'gavel',
    title: 'Nakon nadmetanja',
    body: 'Najbolji ponuđač plaća cijenu u roku iz zaključka; ako ne plati, gubi kaparu. Sud donosi rješenje o dosudi, a porezi i troškovi prijenosa idu na kupca.',
  },
];
---

<Base
  title="Kako se nadmetati na sudskoj prodaji u BiH"
  description="Kratak pregled postupka sudske prodaje: kapara, ročišta, pregled predmeta i šta slijedi nakon nadmetanja."
>
  <div class="gut border-b border-rule pb-[26px] pt-[34px]">
    <h1 class="max-w-[24ch] font-serif text-[2rem] leading-title tracking-title sm:text-[2.5rem] sm:leading-display sm:tracking-display">
      Kako se nadmetati na sudskoj prodaji
    </h1>
    <p class="mt-3 max-w-[64ch] text-[0.875rem] leading-relaxed text-muted">
      Kratak pregled postupka. Nije pravni savjet - pravila su u Zakonu o izvršnom postupku i u samom
      zaključku suda, a razlikuju se u FBiH, RS i Brčko distriktu.
    </p>
  </div>

  <div class="grid lg:grid-cols-[1fr_300px]">
    <div class="gut border-rule pb-[34px] pt-[26px] lg:border-r">
      <ol class="flex flex-col gap-[22px]">
        {
          steps.map((s, i) => (
            <li class="grid grid-cols-[44px_1fr] gap-4">
              <span class="flex flex-col items-start gap-2 font-mono text-[1.375rem] tracking-num font-bold leading-none text-bar">
                {String(i + 1).padStart(2, '0')}
                <Icon name={s.icon} size={20} class="text-bar" />
              </span>
              <div>
                <h2 class="font-serif text-[1.3125rem] tracking-head leading-tight">{s.title}</h2>
                <p class="mt-2 max-w-[68ch] text-[0.875rem] leading-relaxed text-ink-body">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="gut bg-band pb-[34px] pt-[26px]">
      <h2 class="flex items-center gap-1.5 border-b border-rule pb-2 text-[0.6875rem] font-semibold uppercase leading-none tracking-caps text-dim">
        <Icon name="map-trifold" size={13} class="text-faint" />
        Razlike po entitetu
      </h2>
      <p class="mt-3 text-[0.78125rem] leading-relaxed text-ink-body">
        Rokovi, visina osiguranja i način prodaje razlikuju se između {
          entities.map((e, i) => (
            <>
              {i > 0 && (i === entities.length - 1 ? ' i ' : ', ')}
              {ENTITY_NAMES[e.key] ?? e.key} ({e.count})
            </>
          ))
        }. Uvijek se ravnajte po zaključku suda koji vodi postupak.
      </p>

      <h2 class="mt-6 flex items-center gap-1.5 border-b border-rule pb-2 text-[0.6875rem] font-semibold uppercase leading-none tracking-caps text-dim">
        <Icon name="gavel" size={13} class="text-faint" />
        Načini prodaje u podacima
      </h2>
      <dl class="mt-2 font-mono text-[0.78125rem] leading-[1.9]">
        {
          methods.map((m) => (
            <div class="flex justify-between gap-3">
              <dt>{m.label}</dt>
              <dd>{m.count}</dd>
            </div>
          ))
        }
      </dl>

      <div class="mt-6 border border-edge bg-sheet p-3.5">
        <h2 class="flex items-center gap-1.5 text-[0.75rem] font-semibold leading-none">
          <Icon name="shield-check" size={14} class="text-pine" />
          Nemamo podatke o strankama
        </h2>
        <p class="mt-2 text-[0.75rem] leading-relaxed text-muted">
          Imena dužnika i vjerovnika, adrese i kontakti se ne objavljuju ni ne prikupljaju. Za pitanja
          o postupku obratite se sudu iz oglasa.
        </p>
      </div>
    </aside>
  </div>
</Base>
