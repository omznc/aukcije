---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { listings } from '../lib/data.ts';
import { CONTACT_EMAIL } from '../../config.ts';

const example = listings[0]?.id ?? '65-164836';
---

<Base title="Privatnost i zahtjev za uklanjanje podataka">
  <div class="gut border-b border-rule pb-[26px] pt-[34px]">
    <h1 class="font-serif text-[2rem] leading-title tracking-title sm:text-[2.5rem] sm:leading-display sm:tracking-display">
      Privatnost i uklanjanje sadržaja
    </h1>
    <p class="mt-3 max-w-[64ch] text-[0.875rem] leading-relaxed text-muted">
      Ovaj sajt objavljuje samo ono što je sud već javno objavio, i to u sažetom obliku.
    </p>
  </div>

  <div class="gut grid gap-8 pb-9 pt-[26px] md:grid-cols-2">
    <div>
      <h2 class="border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="shield-check" size={14} class="mr-1.5 text-pine" />
        Šta ne objavljujemo
      </h2>
      <ul class="mt-3 text-[0.84375rem] leading-[1.9] text-ink-soft">
        <li>- imena dužnika, vjerovnika i drugih fizičkih lica</li>
        <li>- adrese stanovanja</li>
        <li>- JMBG i druge identifikacijske brojeve</li>
        <li>- kontakt podatke stranaka</li>
        <li>- puni tekst oglasa</li>
      </ul>
      <p class="mt-3.5 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Prije svakog objavljivanja skripta provjerava sadržaj i zaustavlja objavu ako se bilo koji od
        tih podataka pojavi.
      </p>

      <h2 class="mt-7 border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="list-bullets" size={14} class="mr-1.5 text-faint" />
        Šta objavljujemo
      </h2>
      <p class="mt-3 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Samo ono što je kupcu potrebno da učestvuje na nadmetanju: naziv suda, broj predmeta, vrstu i
        opis predmeta prodaje, katastarske oznake, općinu, procijenjenu vrijednost, najnižu cijenu,
        iznos osiguranja, te datum, vrijeme i mjesto ročišta.
      </p>

      <h2 class="mt-7 border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="lock-key" size={14} class="mr-1.5 text-faint" />
        Kolačići i analitika
      </h2>
      <p class="mt-3 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Nema kolačića, računa ni praćenja. Sačuvani oglasi i praćene kategorije ostaju u vašem
        pregledniku i ne šalju se nikome - pogledati ih i obrisati možete na stranici{' '}
        <a href="/sacuvano/" class="text-pine underline">Sačuvano</a>. Pretraga se izvršava u vašem
        pregledniku. Ako prebacite stranicu na tamni ili svijetli prikaz, i taj izbor ostaje tu -
        to je jedini drugi zapis koji ova stranica ostavlja.
      </p>
    </div>

    <div>
      <h2 class="border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="trash" size={14} class="mr-1.5 text-faint" />
        Zahtjev za uklanjanje
      </h2>
      <p class="mt-3 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Ako smatrate da neki zapis sadrži podatke koji ne bi trebali biti javni ili da je netačan,
        pošaljite ID oglasa i kratko objašnjenje. Zapis uklanjamo ili ispravljamo bez odlaganja.
      </p>
      <div class="mt-3.5 border border-rule bg-blank p-4">
        <div class="flex items-center gap-1.5 font-mono text-[0.6875rem] leading-none text-dim">
          <Icon name="warning-circle" size={13} class="text-rust" />
          KAKO PRIJAVITI
        </div>
        <div class="mt-2.5 text-[0.8125rem] font-medium leading-snug">
          Pišite na <a href={`mailto:${CONTACT_EMAIL}`} class="text-pine underline">{CONTACT_EMAIL}</a>.
        </div>
        <div class="mt-2.5 text-[0.75rem] leading-relaxed text-muted">
          Navedite ID oglasa, npr. <span class="font-mono">{example}</span>, ili poveznicu na
          stranicu oglasa.
        </div>
      </div>

      <h2 class="mt-7 border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="scales" size={14} class="mr-1.5 text-faint" />
        Pravni osnov
      </h2>
      <p class="mt-3 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Sudske prodaje su javno objavljeni službeni oglasi, objavljeni upravo zato da bi javnost
        mogla učestvovati. Obrada se zasniva na legitimnom interesu informisanja javnosti o javnim
        prodajama, uz minimizaciju podataka u skladu sa Zakonom o zaštiti ličnih podataka
        („Službeni glasnik BiH”, broj 12/25).
      </p>

      <h2 class="mt-7 border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim">
        <Icon name="bank" size={14} class="mr-1.5 text-faint" />
        Odnos prema sudovima
      </h2>
      <p class="mt-3 max-w-[56ch] text-[0.8125rem] leading-relaxed text-muted">
        Sajt nije povezan s pravosuđem BiH i nije službena objava. Podaci se izvlače automatski i mogu
        sadržavati greške u prepoznavanju iznosa, datuma ili opisa - mjerodavni su isključivo dokumenti
        na pravosudje.ba, na koje svaka stranica oglasa vodi.
      </p>
    </div>
  </div>
</Base>
