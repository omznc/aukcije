        <section class="mt-7 border border-rule bg-blank" data-pagefind-ignore>
          <h2 class="flex items-center gap-2 border-b border-rule bg-band px-[18px] py-3.5 text-[0.8125rem] font-semibold leading-none">
            <Icon name="seal-check" size={16} class="text-pine" />
