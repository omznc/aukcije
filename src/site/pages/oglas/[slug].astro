          </h2>
          <div class="flex flex-col gap-3 px-[18px] py-4">
            <div class="flex flex-wrap items-center justify-between gap-3">
              <span class="text-[0.8125rem] font-medium leading-snug">
                Oglas na pravosudje.ba
                <span class="font-mono text-[0.71875rem] font-normal text-dim">/{l.articleId}</span>
              </span>
              <a
                href={l.sourceUrl}
                rel="nofollow noopener"
                target="_blank"
                class="flex shrink-0 items-center gap-1.5 bg-ink px-3 py-2 text-[0.75rem] font-semibold leading-none text-on-ink"
              >
                <Icon name="arrow-square-out" size={14} />
                Otvori
              </a>
            </div>
            {
              l.documents.map((d) => (
                <div class="flex flex-wrap items-center justify-between gap-3 border-t border-hair pt-3">
                  <span class="text-[0.8125rem] font-medium leading-snug">
                    {d.name.trim() || 'Dokument suda'}{' '}
                    <span class="font-mono text-[0.6875rem] font-normal text-dim">
                      {d.type}
                      {d.sha256 && ` · SHA256 ${d.sha256.slice(0, 4)}…${d.sha256.slice(-4)}`}
                    </span>
                  </span>
                  <a
                    href={d.url}
                    rel="nofollow noopener"
                    target="_blank"
                    class="flex shrink-0 items-center gap-1.5 press press-give border border-rule px-3 py-2 text-[0.75rem] font-semibold leading-none hover:border-ink"
                  >
                    <Icon name="file-arrow-down" size={14} class="text-dim" />
                    Preuzmi
                  </a>
                </div>
              ))
            }
          </div>
        </section>

        <div class="mt-4 border border-warn-edge bg-warn-bg px-4 py-3.5" data-pagefind-ignore>
          <h2 class="flex items-center gap-2 text-[0.75rem] font-semibold leading-none">
            <Icon name="warning" size={15} class="text-rust" />
            Podaci na ovoj stranici izvučeni su automatski i mogu biti netačni
          </h2>
          <p class="mt-2 max-w-[74ch] text-[0.78125rem] leading-relaxed text-muted">
            Cijene, površine i datumi čitani su iz sudskog dokumenta programski. Prije nadmetanja
            obavezno provjerite original. Ovaj sajt nije sud, nije posrednik i ne prodaje ništa.
          </p>
        </div>

        <p class="mt-3 font-mono text-[0.6875rem] leading-relaxed text-faint" data-pagefind-ignore>
          IZVOR PODATAKA: {l.extraction.source.toUpperCase()} · POUZDANOST {l.extraction.confidence.toFixed(2)} ·
          MODELSKA DOPUNA: {l.extraction.llm ? 'DA' : 'NE'} · PREUZETO {scraped.toUpperCase()}
        </p>
      </div>

      <aside class="gut bg-band pb-[30px] pt-6" data-pagefind-ignore>
        <h2 class="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase leading-none tracking-caps text-dim">
          <Icon name="hourglass-medium" size={13} class="text-faint" />
          Odbrojavanje
        </h2>
        <div class="mt-2.5 border border-rule bg-sheet p-4">
          <div
            class:list={[
              'font-mono text-[2.125rem] tracking-num font-bold leading-none',
              state === 'past' ? 'text-dim' : state === 'later' ? 'text-ink' : 'text-brick',
            ]}
          >
            {state === 'past' ? 'prošlo' : daysLabel(days)}
          </div>
          <p class="mt-2.5 text-[0.75rem] leading-relaxed text-muted">
            {
              state === 'past'
                ? `Ročište je održano ${formatDate(l.saleDate)}. Zapis ostaje u arhivi kao referenca cijene.`
                : `Ročište ${formatDate(l.saleDate)}${l.saleTime ? ` u ${l.saleTime}` : ''}.${l.deposit ? ' Kaparu je potrebno uplatiti prije početka nadmetanja.' : ''}`
            }
          </p>
        </div>

        <Locator
          settlement={l.location?.settlement ?? null}
          municipality={l.location?.municipality ?? null}
          courtId={l.courtId}
          court={l.court}
        />

        {
          chain.length > 1 && (
            <>
              <h2 class="mt-7 flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase leading-none tracking-caps text-dim">
                <Icon name="arrows-clockwise" size={13} class="text-faint" />
                Ovo je {chainPosition}. ročište za isti predmet
              </h2>
              <ol class="mt-3">
                {chain.map((c, i) => (
                  <li class="grid grid-cols-[14px_1fr] gap-3">
                    <div class="flex flex-col items-center">
                      <span
                        class:list={[
                          'mt-1.5 h-[9px] w-[9px] rounded-full',
                          c.id === l.id ? 'bg-pine' : 'bg-bar',
                        ]}
                      />
                      {i < chain.length - 1 && <span class="w-px flex-1 bg-rule" />}
                    </div>
                    <div class:list={[i < chain.length - 1 && 'pb-4']}>
                      <div
                        class:list={[
                          'font-mono text-[0.78125rem] font-medium leading-none',
                          c.id === l.id ? 'text-pine' : 'text-dim',
                        ]}
                      >
                        {formatDate(c.saleDate)} · {ROUND_SHORT[c.auctionRound] ?? `${i + 1}. ročište`}
                      </div>
                      <div class="mt-1.5 text-[0.84375rem] font-medium leading-snug">
                        {formatMoney(c.startingPrice ?? c.appraisedValue) ?? 'cijena nije navedena'}
                        {c.id === l.id && state !== 'past' && ' - otvoreno'}
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
              <p class="mt-3 text-[0.71875rem] leading-relaxed text-dim">
                Lanac je povezan po broju predmeta iz sudskog dokumenta. Ishod ranijih ročišta se ne
                objavljuje, pa ga ni mi ne znamo.
              </p>
            </>
          )
        }

        {
          similar.length > 0 && (
            <>
              <h2 class="mt-7 flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase leading-none tracking-caps text-dim">
                <Icon name="scales" size={13} class="text-faint" />
                Uporedive prodaje - {TAG_BY_ID.get(l.itemTags[0])?.label.toLowerCase() ?? 'slični predmeti'}
              </h2>
              <div class="mt-2 flex flex-col">
                {similar.map((c) => {
                  const cPerM2 = pricePerM2(c);
                  return (
                    <a
                      href={hrefOf(c)}
                      class="flex justify-between gap-2.5 border-b border-rule py-2.5 text-[0.78125rem] leading-snug press last:border-0 hover:text-pine"
                    >
                      <span>{headline(c)}</span>
                      <span class="shrink-0 font-mono">
                        {cPerM2
                          ? `${formatNumber(cPerM2)} KM/m²`
                          : (formatMoney(c.startingPrice ?? c.appraisedValue) ?? '-')}
                      </span>
                    </a>
                  );
                })}
              </div>
            </>
          )
        }

        <!--
          Nothing here can e-mail a reminder, so the calendar file is the only
          way a static site puts this date in front of someone on the day it
          matters. It carries two alarms, the earlier one a week out, because
          the deadline that actually binds is the deposit rather than the
          hearing.
        -->
        <div class="mt-6 border border-edge bg-sheet p-[13px]">
          <h2 class="flex items-center gap-1.5 text-[0.6875rem] font-semibold uppercase leading-none tracking-label">
            <Icon name="calendar-plus" size={13} class="text-pine" />
            Dodaj u kalendar
          </h2>
          <p class="mb-2.5 mt-2 text-[0.75rem] leading-relaxed text-muted">
            Podsjetnik 7 dana i 1 dan ranije - kapara se uplaćuje prije ročišta.
          </p>
          <a
            href={icsHrefOf(l)}
            download={`rociste-${l.id}.ics`}
            class="press press-give flex items-center justify-center gap-1.5 border border-ink bg-ink px-3 py-2.5 text-[0.75rem] font-semibold leading-none text-on-ink"
          >
            <Icon name="calendar-plus" size={14} />
            Preuzmi .ics
          </a>
          {
            !l.saleTime && (
              <p class="mt-2 text-[0.71875rem] leading-relaxed text-dim">
                Oglas ne navodi vrijeme, pa je upisano 09:00 kao pretpostavka.
              </p>
            )
          }
        </div>

        <div class="mt-4 flex flex-wrap gap-2">
          <SaveToggle storeKey={`sacuvano:oglas:${l.id}`} label="Sačuvaj oglas" activeLabel="Sačuvano ✓" />
          <button
            type="button"
            id="share"
            class="flex items-center gap-1.5 press press-give border border-rule px-3 py-2.5 text-[0.75rem] font-semibold leading-none hover:border-ink"
          >
            <Icon name="share-network" size={14} class="text-dim" />
            <span class="swap">
              <span data-idle>Podijeli</span>
              <span data-done aria-hidden="true">Link kopiran</span>
            </span>
          </button>
        </div>
      </aside>
    </div>
  </article>
</Base>
)}

<script>
  // The arithmetic lives in lib/costs.ts so the rules are written down once;
  // this only reads the inputs and prints the result. The deposit is the one
  // figure that is not editable - it comes from the notice - so it rides in on
  // a data attribute rather than through a global.
  import { costs, formatKm } from '../../lib/costs.ts';

  const form = document.getElementById('cost') as HTMLElement | null;
  const bid = document.getElementById('cost-bid') as HTMLInputElement | null;

  if (form && bid) {
    const taxInput = document.getElementById('cost-tax') as HTMLInputElement;
    const feesInput = document.getElementById('cost-fees') as HTMLInputElement;
    const otherInput = document.getElementById('cost-other') as HTMLInputElement;
    const vat = document.getElementById('cost-vat') as HTMLInputElement | null;
    const useAltBase = document.getElementById('cost-base') as HTMLInputElement | null;

    const attr = (k: string) => (form.dataset[k] ? Number(form.dataset[k]) : null);
    const deposit = attr('deposit');
    const floor = attr('floor');
    const altBase = attr('base');
    /** The rate the page opened with, to restore when the VAT box is cleared. */
    const seedRate = Number(form.dataset.rate ?? 0) * 100;
    const vatRate = Number(form.dataset.vat ?? 0) * 100;

    const out = {
      deposit: document.getElementById('cost-deposit')!,
      balance: document.getElementById('cost-balance')!,
      tax: document.getElementById('cost-tax-out')!,
      taxRow: document.getElementById('cost-tax-row')!,
      taxLabel: document.getElementById('cost-tax-label')!,
      fees: document.getElementById('cost-fees-out')!,
      other: document.getElementById('cost-other-out')!,
      otherRow: document.getElementById('cost-other-row') as HTMLElement,
      total: document.getElementById('cost-total')!,
      floor: document.getElementById('cost-floor') as HTMLElement | null,
    };

    /** An empty or nonsense field reads as zero rather than as NaN on the page. */
    const num = (el: HTMLInputElement) => {
      const n = Number(el.value);
      return Number.isFinite(n) && n > 0 ? n : 0;
    };

    // Ticking VAT swaps the rate rather than adding to it: the two are
    // alternatives in law, never both at once.
    vat?.addEventListener('change', () => {
      taxInput.value = String(vat.checked ? vatRate : seedRate).replace(/\.0$/, '');
      const name = vat.checked ? 'PDV' : 'Porez na promet';
      out.taxLabel.textContent = `${name} (%)`;
      out.taxRow.textContent = name;
      render();
    });

    function render() {
      const amount = num(bid!);
      const base = useAltBase?.checked && altBase !== null ? altBase : amount;
      const b = costs({
        bid: amount,
        deposit,
        taxRate: num(taxInput) / 100,
        taxBase: base,
        fees: num(feesInput),
        other: num(otherInput),
      });
      out.deposit.textContent = b.deposit ? formatKm(b.deposit) : '-';
      out.balance.textContent = formatKm(b.balance);
      out.tax.textContent = formatKm(b.tax);
      out.fees.textContent = formatKm(b.fees);
      out.other.textContent = formatKm(b.other);
      out.otherRow.hidden = b.other === 0;
      out.total.textContent = formatKm(b.total);
      // Rounding hides a bid one mark under the floor, so compare before it.
      if (out.floor && floor !== null) out.floor.hidden = amount === 0 || amount >= floor;
    }

    for (const el of [bid, taxInput, feesInput, otherInput]) el.addEventListener('input', render);
    useAltBase?.addEventListener('change', render);
    render();
  }
</script>

<script>
  const share = document.getElementById('share') as HTMLButtonElement | null;

  if (share) {
    const idle = share.querySelector('[data-idle]')!;
    const done = share.querySelector('[data-done]')!;
    let restore: ReturnType<typeof setTimeout>;

    /*
      Both labels are already in the button, so confirming a copy is a flag on
      the button rather than new text: the stylesheet cross-fades them and the
      icon beside them is left alone. Only one is exposed at a time, so a screen
      reader hears the button say one thing.
    */
    const swapped = (on: boolean) => {
      share.toggleAttribute('data-swapped', on);
      idle.toggleAttribute('aria-hidden', on);
      done.toggleAttribute('aria-hidden', !on);
    };

    share.addEventListener('click', async () => {
      const url = location.href;
      const title = document.title;
      try {
        if (navigator.share) await navigator.share({ title, url });
        else {
          await navigator.clipboard.writeText(url);
          swapped(true);
          // A second copy before the first has reset restarts the two seconds.
          clearTimeout(restore);
          restore = setTimeout(() => swapped(false), 2000);
        }
      } catch {
        // A dismissed share sheet or a denied clipboard is not an error worth reporting.
      }
    });
  }
</script>
