---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Locator from '../../components/Locator.astro';
import { foldPlaceName } from '../../lib/place-name.ts';
import SaveToggle from '../../components/SaveToggle.astro';
import type { Listing } from '../../../schema.ts';
import {
  listings,
  SALE_TYPE_LABELS,
  ROUND_LABELS,
  METHOD_LABELS,
  TAG_BY_ID,
  formatDate,
  formatMoney,
  daysUntil,
} from '../../lib/data.ts';
import { headline } from '../../lib/headline.ts';
import { hrefOf, icsHrefOf, slugOf } from '../../lib/slug.ts';
import { saleTypeIcon } from '../../lib/icons.ts';
import {
  chainFor,
  comparables,
  discount,
  formatNumber,
  formatPercent,
  pricePerM2,
  daysLabel,
  urgency,
  ROUND_SHORT,
} from '../../lib/stats.ts';
import {
  taxSeedFor,
  depositFor,
  floorFor,
  feesFor,
  formatKm,
  PROVENANCE_LABEL,
  PAYMENT_DEADLINE_DAYS,
  VAT_RATE,
  UNPRICED,
  NOT_PAYABLE,
  type Lot,
  type Entity,
} from '../../lib/costs.ts';
import { listingJsonLd } from '../../lib/jsonld.ts';

/**
 * Two paths per listing, and only one of them is a page.
 *
 * The slug is where a notice actually lives. The bare id is where it used to
 * live - roughly 2,700 of those are indexed, shared and bookmarked, and the
 * saved-listings page still builds links from ids held in localStorage, where
 * no headline is guaranteed to match the current build. So the old address
 * stays, as a stub that sends the reader on.
 *
 * A static host has no 301 to offer, so the stub is a meta refresh carrying the
 * canonical of the real page. It is what a search engine follows and what a
 * browser follows, and it is the only honest option without a server in front.
 */
export function getStaticPaths() {
  return listings.flatMap((l) => {
    const slug = slugOf(l);
    const canonical = { params: { slug: `${slug}-${l.id}` }, props: { listing: l, redirect: false } };
    // A listing with no usable headline is already at its bare id; emitting the
    // stub too would be a page redirecting to itself.
    return slug
      ? [canonical, { params: { slug: l.id }, props: { listing: l, redirect: true } }]
      : [{ params: { slug: l.id }, props: { listing: l, redirect: false } }];
  });
}

interface Props {
  listing: Listing;
  redirect: boolean;
}
const { listing: l, redirect } = Astro.props;
const destination = new URL(hrefOf(l), Astro.site).href;

const days = daysUntil(l.saleDate);
const state = urgency(days);
const off = discount(l);
const perM2 = pricePerM2(l);
const title = headline(l);
const chain = chainFor(l);
const chainPosition = chain.findIndex((c) => c.id === l.id) + 1;
const similar = comparables(l);
const cadastral = [
  ...(l.cadastral?.kc ?? []).map((v) => `k.č. ${v}`),
  ...(l.cadastral?.zkUlozak ?? []).map((v) => `zk. uložak ${v}`),
  ...(l.cadastral?.ko ?? []).map((v) => `k.o. ${v}`),
].join(' · ');

// Compared folded, because the two fields come from different readings of the
// same notice and disagree on spelling more often than on place: the header
// says Žepče and the register says ŽEPĆE, and printing both as if they were
// two facts is worse than printing neither.
const settlement =
  l.location?.settlement &&
  foldPlaceName(l.location.settlement) !== foldPlaceName(l.location.municipality ?? '')
    ? l.location.settlement
    : null;

/** Absent values are stated rather than hidden: a bidder needs to know the notice was silent. */
const NOT_STATED = 'nije navedeno u oglasu';

const facts: Array<[string, string | null, boolean, string]> = [
  ['Datum i vrijeme', `${formatDate(l.saleDate)}${l.saleTime ? ` u ${l.saleTime}` : ''}`, false, 'calendar-dots'],
  ['Mjesto', l.auctionLocation, true, 'map-pin'],
  ['Način prodaje', l.saleMethod === 'nepoznato' ? null : METHOD_LABELS[l.saleMethod], true, 'gavel'],
  ['Ročište po redu', ROUND_LABELS[l.auctionRound], false, 'hourglass-medium'],
  ['Kapara / osiguranje', formatMoney(l.deposit), true, 'hand-coins'],
  ['Broj predmeta', l.caseNumber, true, 'hash'],
  ['Objavljeno', formatDate(l.publishedDate), false, 'calendar-plus'],
  ['Pregled predmeta', l.viewingInfo, true, 'eye'],
  ['Katastar', cadastral || null, false, 'map-trifold'],
  // Suppressed when it merely repeats the municipality: a k.o. named after its
  // own town ("k.o. Lukavac" in Lukavac) adds a row and no information.
  ['Naselje', settlement, false, 'map-pin-area'],
  ['Općina', l.location?.municipality ?? null, false, 'buildings'],
  ['Jezik oglasa', l.language, false, 'translate'],
];

const scraped = new Intl.DateTimeFormat('bs-BA', {
  dateStyle: 'short',
  timeStyle: 'short',
  timeZone: 'Europe/Sarajevo',
}).format(new Date(l.scrapedAt));

const CHIP_OUTLINE = 'border border-edge px-2 py-[5px] font-mono text-[0.65625rem] font-semibold leading-none';

/**
 * Seed values for the cost calculator. Every rate here is editable in the page,
 * because the transfer tax is cantonal in FBiH, its taxpayer differs by canton,
 * and the fees are a shape rather than a quoted tariff - see lib/costs.ts.
 */
const lot: Lot = {
  entity: l.entity as Entity,
  courtId: l.courtId,
  saleType: l.saleType,
  auctionRound: l.auctionRound,
  appraised: l.appraisedValue?.amount ?? null,
  starting: l.startingPrice?.amount ?? null,
  deposit: l.deposit?.amount ?? null,
};

const tax = taxSeedFor(lot);
const dep = depositFor(lot);
/*
  The bid opens at the lowest price this hearing may accept, never at the
  appraisal: the appraisal is the ceiling the floor is derived FROM, and seeding
  it anchored 1.174 notices at two to three times what the hearing starts at.
*/
const floor = floorFor(lot);
const seed = {
  bid: floor?.amount ?? 0,
  fees: feesFor(floor?.amount ?? 0, l.saleType),
};
/* The tax base the cantonal law actually names, where we can offer it as a choice. */
const altBase = tax.basis === 'trzisna' && lot.appraised && floor && lot.appraised > floor.amount
  ? lot.appraised
  : null;
const unpriced = UNPRICED.filter((u) => u.types.includes(l.saleType));

const jsonLd = JSON.stringify(
  listingJsonLd(l, Astro.site?.href.replace(/\/$/, '') ?? ''),
).replace(/</g, '\\u003c');
---

{/*
  The old address. A static host cannot answer 301, so this is the closest
  honest equivalent: a canonical pointing at the real page for anything that
  indexes, a meta refresh for anything that renders, `noindex, follow` so the
  stub itself never competes with the page it points at, and a plain link for
  the case where neither runs.
*/}
{redirect ? (
  <html lang="bs">
    <head>
      <meta charset="utf-8" />
      <meta http-equiv="refresh" content={`0; url=${destination}`} />
      <link rel="canonical" href={destination} />
      <meta name="robots" content="noindex, follow" />
      <title>{headline(l)}</title>
    </head>
    <body>
      <a href={destination}>{headline(l)}</a>
    </body>
  </html>
) : (
<Base
  title={`${title.slice(0, 70)} - ${l.court}`}
  description={`Sudska prodaja: ${title.slice(0, 150)}`}
  image={`/og/${l.id}.png`}
>
  <script type="application/ld+json" is:inline set:html={jsonLd} />
  <article data-pagefind-body>
    <div class="gut border-b border-rule pb-[22px] pt-[26px]">
      <nav class="mb-3.5 font-mono text-[0.6875rem] leading-none text-dim" data-pagefind-ignore>
        <a href="/" class="hover:text-ink">AKTUELNE</a> / OGLAS {l.id}
      </nav>

      <div class="mb-3.5 flex flex-wrap gap-[7px]" data-pagefind-ignore>
        <span class="flex items-center gap-1.5 bg-ink px-2 py-[5px] font-mono text-[0.65625rem] font-semibold leading-none text-on-ink">
          <Icon name={saleTypeIcon(l.saleType)} size={13} />
          {SALE_TYPE_LABELS[l.saleType].toUpperCase()}
        </span>
        <span class={CHIP_OUTLINE}>{l.entity}</span>
        {ROUND_SHORT[l.auctionRound] && <span class={CHIP_OUTLINE}>{ROUND_SHORT[l.auctionRound]!.toUpperCase()}</span>}
        <span
          class:list={[
            'px-2 py-[5px] font-mono text-[0.65625rem] font-semibold leading-none',
            state === 'past'
              ? 'bg-band text-dim'
              : state === 'later'
                ? 'border border-edge'
                : 'bg-due-bg text-brick',
          ]}
        >
          {state === 'past' ? 'ROČIŠTE JE PROŠLO' : `ZA ${daysLabel(days).toUpperCase()}`} · {formatDate(l.saleDate)}
        </span>
      </div>

      <h1
        class="max-w-[26ch] font-serif text-[1.875rem] leading-title tracking-title sm:text-[2.375rem] sm:leading-display sm:tracking-display"
        data-pagefind-meta="title"
      >
        {title}
      </h1>
      <!-- Reference line, not content: indexing it opened every search excerpt on it. -->
      <p class="mt-3 max-w-[80ch] font-mono text-[0.78125rem] leading-relaxed text-dim" data-pagefind-ignore>
        Naslov iz sudskog dokumenta: „{l.title}”
      </p>

      <div class="hidden" data-pagefind-filter={`sud:${l.court}`}></div>
      <div class="hidden" data-pagefind-filter={`vrsta:${SALE_TYPE_LABELS[l.saleType]}`}></div>
      <div class="hidden" data-pagefind-filter={`entitet:${l.entity}`}></div>
      <div class="hidden" data-pagefind-filter={`godina:${l.saleDate.slice(0, 4)}`}></div>
      <div class="hidden" data-pagefind-filter={`status:${state === 'past' ? 'Arhiva' : 'Otvoreno'}`}></div>
      <div class="hidden" data-pagefind-sort={`datum:${l.saleDate}`}></div>
      {/* Zero-padded so Pagefind's string ordering matches numeric order; unpriced notices sort last. */}
      <div
        class="hidden"
        data-pagefind-sort={`cijena:${String(
          Math.round((l.startingPrice ?? l.appraisedValue)?.amount ?? 0),
        ).padStart(12, '0')}`}
      >
      </div>
      {/*
        Search results are rendered by this site, so they need the row's own
        fields. One key per element: Pagefind reads a single `key:value` pair
        from an attribute, and several of these values contain commas.
      */}
      <div class="hidden" data-pagefind-meta={`status:${state === 'past' ? 'Arhiva' : 'Otvoreno'}`}></div>
      <div class="hidden" data-pagefind-meta={`datum:${formatDate(l.saleDate)}`}></div>
      <div class="hidden" data-pagefind-meta={`sud:${l.court}`}></div>
      <div class="hidden" data-pagefind-meta={`rociste:${ROUND_SHORT[l.auctionRound] ?? '-'}`}></div>
      <div
        class="hidden"
        data-pagefind-meta={`cijena:${formatMoney(l.startingPrice ?? l.appraisedValue) ?? '-'}`}
      >
      </div>
    </div>

    <div class="grid lg:grid-cols-[1fr_340px]">
      <div class="gut border-rule pb-[30px] pt-6 lg:border-r">
        <!--
          Kept out of the search index: the amounts are carried as metadata, and
          leaving them in the body made every excerpt open on a wall of figures
          instead of on the description that matched.
        -->
        <dl class="grid grid-cols-1 gap-px border border-rule bg-rule sm:grid-cols-3" data-pagefind-ignore>
          <div class="bg-blank px-4 py-3.5">
            <dt class="flex items-center gap-1.5 font-mono text-[0.625rem] leading-none text-dim">
              <Icon name="receipt" size={13} class="text-ghost" />
              PROCIJENJENA VRIJEDNOST
            </dt>
            <dd class="mt-2.5 font-mono text-[1.25rem] tracking-num leading-none text-dim line-through">
              {formatMoney(l.appraisedValue) ?? '-'}
            </dd>
          </div>
          <div class="bg-blank px-4 py-3.5">
            <dt class="flex items-center gap-1.5 font-mono text-[0.625rem] leading-none text-dim">
              <Icon name="money" size={13} class="text-ghost" />
              POČETNA CIJENA
            </dt>
            <dd class="mt-2.5 font-mono text-[1.25rem] tracking-num font-bold leading-none">
              {formatMoney(l.startingPrice) ?? <span class="font-normal text-ghost">nije navedena</span>}
            </dd>
          </div>
          <div class="bg-blank px-4 py-3.5">
            <dt class="flex items-center gap-1.5 font-mono text-[0.625rem] leading-none text-dim">
              <Icon name="trend-down" size={13} class="text-ghost" />
              POPUST{perM2 && ` · ${formatNumber(perM2)} KM/m²`}
            </dt>
            <dd
              class:list={['mt-2.5 font-mono text-[1.25rem] tracking-num font-bold leading-none', off && off > 0 && 'text-pine']}
            >
              {off === null ? <span class="font-normal text-ghost">-</span> : formatPercent(off)}
            </dd>
          </div>
        </dl>

        <section class="mt-6">
          <h2 class="border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim"
            data-pagefind-ignore
          >
            <Icon name="package" size={13} class="mr-1.5 text-faint" />
            Predmet prodaje
          </h2>
          <p class="mt-3 max-w-[70ch] text-pretty text-[0.875rem] leading-relaxed text-ink-soft">
            {l.itemDescription ?? 'Opis predmeta nije bilo moguće pročitati iz dokumenta.'}
          </p>
          {
            l.itemTags.length > 0 && (
              <div class="mt-3.5 flex flex-wrap gap-1.5" data-pagefind-ignore>
                {l.itemTags.map((t) => (
                  <a
                    href={`/predmeti/${t}/`}
                    class="press press-give border border-edge px-2.5 py-[7px] text-[0.71875rem] font-medium leading-none hover:border-ink"
                  >
                    {TAG_BY_ID.get(t)?.label ?? t}
                  </a>
                ))}
              </div>
            )
          }
        </section>

        <section class="mt-7">
          <h2 class="border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label text-dim"
            data-pagefind-ignore
          >
            <Icon name="clipboard-text" size={13} class="mr-1.5 text-faint" />
            Ročište i podaci
          </h2>
          <dl class="mt-1 grid grid-cols-1 sm:grid-cols-[190px_1fr]">
            {
              facts
                .filter(([, value, showWhenMissing]) => value || showWhenMissing)
                .map(([key, value, , icon]) => (
                  <>
                    <dt
                      class="flex items-center gap-2 pt-2.5 text-[0.78125rem] leading-none text-dim sm:border-b sm:border-hair sm:pb-2.5"
                      data-pagefind-ignore
                    >
                      <Icon name={icon} size={14} class="text-ghost" />
                      {key}
                    </dt>
                    <dd
                      class:list={[
                        'border-b border-hair pb-2.5 pt-1 text-[0.8125rem] leading-snug sm:pt-2.5',
                        value ? 'font-medium' : 'text-faint',
                      ]}
                    >
                      {value ?? NOT_STATED}
                    </dd>
                  </>
                ))
            }
            <dt
              class="flex items-center gap-2 pt-2.5 text-[0.78125rem] leading-none text-dim sm:border-b sm:border-hair sm:pb-2.5"
              data-pagefind-ignore
            >
              <Icon name="bank" size={14} class="text-ghost" />
              Sud
            </dt>
            <dd class="border-b border-hair pb-2.5 pt-1 text-[0.8125rem] font-medium leading-snug sm:pt-2.5">
              <a href={`/sudovi/${l.courtId}/`} class="text-pine hover:text-ink">{l.court}</a> · {l.entity}
            </dd>
          </dl>
        </section>

        {/*
          The notice states one number and every bidder then discovers the rest
          separately. Every rate is an input rather than a constant, and every
          figure carries where it came from, because the three entities are three
          regimes and FBiH is ten more inside one: the rate is cantonal, and so
          is the answer to who owes it. A calculator that hid that behind a
          single 5% was billing the buyer for the debtor's liability on 451 of
          the archive's 1.168 real-estate notices.
        */}
        <section class="mt-7 border border-rule bg-blank" data-pagefind-ignore>
          <h2 class="flex items-center gap-2 border-b border-rule bg-band px-[18px] py-3.5 text-[0.8125rem] font-semibold leading-none">
            <Icon name="calculator" size={16} class="text-dim" />
            Šta vas ovo stvarno košta
          </h2>
          <div
            id="cost"
            data-deposit={dep?.amount ?? ''}
            data-floor={floor?.amount ?? ''}
            data-rate={tax.rate}
            data-vat={VAT_RATE}
            data-base={altBase ?? ''}
            class="px-[18px] py-4"
          >
            <div class="flex flex-wrap gap-x-5 gap-y-3">
              <label class="flex flex-col gap-1.5">
                <span class="font-mono text-[0.625rem] uppercase leading-none tracking-caps text-dim">
                  Vaša ponuda (KM)
                </span>
                <input
                  id="cost-bid"
                  type="number"
                  min="0"
                  step="100"
                  value={seed.bid ? Math.round(seed.bid) : ''}
                  class="w-[150px] border border-edge bg-sheet px-2.5 py-2 font-mono text-[0.8125rem] tabular-nums outline-none focus:border-ink"
                />
              </label>
              <label class="flex flex-col gap-1.5">
                <span
                  id="cost-tax-label"
                  class="font-mono text-[0.625rem] uppercase leading-none tracking-caps text-dim"
                >
                  Porez na promet (%)
                </span>
                <input
                  id="cost-tax"
                  type="number"
                  min="0"
                  max="30"
                  step="0.5"
                  value={(tax.rate * 100).toFixed(1).replace(/\.0$/, '')}
                  class="w-[110px] border border-edge bg-sheet px-2.5 py-2 font-mono text-[0.8125rem] tabular-nums outline-none focus:border-ink"
                />
              </label>
              <label class="flex flex-col gap-1.5">
                <span class="font-mono text-[0.625rem] uppercase leading-none tracking-caps text-dim">
                  Takse i upis (KM)
                </span>
                <input
                  id="cost-fees"
                  type="number"
                  min="0"
                  step="50"
                  value={Math.round(seed.fees)}
                  class="w-[110px] border border-edge bg-sheet px-2.5 py-2 font-mono text-[0.8125rem] tabular-nums outline-none focus:border-ink"
                />
              </label>
              <label class="flex flex-col gap-1.5">
                <span class="font-mono text-[0.625rem] uppercase leading-none tracking-caps text-dim">
                  Ostalo (KM)
                </span>
                <input
                  id="cost-other"
                  type="number"
                  min="0"
                  step="100"
                  value="0"
                  class="w-[110px] border border-edge bg-sheet px-2.5 py-2 font-mono text-[0.8125rem] tabular-nums outline-none focus:border-ink"
                />
              </label>
            </div>

            {/*
              A bid under the floor is not a cheap bid, it is a bid the court
              cannot accept - so the calculator says so instead of totalling it.
            */}
            {
              floor && (
                <p
                  id="cost-floor"
                  hidden
                  class="mt-2.5 flex items-start gap-1.5 border border-warn-edge bg-warn-bg px-3 py-2 text-[0.75rem] leading-relaxed text-muted"
                >
                  <Icon name="warning" size={14} class="mt-px shrink-0 text-rust" />
                  <span>
                    Ispod {formatKm(floor.amount)} se na ovom ročištu ne može prodati
                    {floor.from === 'oglas'
                      ? ' - to je početna cijena iz oglasa.'
                      : ` - oglas ne navodi početnu cijenu, pa je ovo ${l.auctionRound === 'prvo' ? 'polovina' : 'trećina'} procijenjene vrijednosti, koliko se na ovakvom ročištu redovno traži.`}
                  </span>
                </p>
              )
            }

            {/*
              PDV is a state tax and cuts across all three entities, so the box
              is offered everywhere - including RS, where the transfer tax is
              gone but VAT is not.
            */}
            <div class="mt-3 flex flex-col gap-1.5">
              <label class="flex items-start gap-2 text-[0.75rem] leading-snug text-muted">
                <input id="cost-vat" type="checkbox" class="mt-px accent-pine" />
                <span>
                  Izvršenik je u sistemu PDV-a i predmet je poslovna imovina ili prvi prenos -
                  obračunaj PDV od {(VAT_RATE * 100).toFixed(0)}%{tax.rate > 0 && ' umjesto poreza na promet'}
                </span>
              </label>
              {
                altBase && (
                  <label class="flex items-start gap-2 text-[0.75rem] leading-snug text-muted">
                    <input id="cost-base" type="checkbox" class="mt-px accent-pine" />
                    <span>
                      Obračunaj porez na procijenjenu vrijednost ({formatKm(altBase)}), a ne na
                      ponudu - kantonalni zakon oporezuje tržišnu vrijednost koju utvrđuje komisija
                    </span>
                  </label>
                )
              }
            </div>

            {/*
              The old single "Ukupno" hid the thing that actually catches people
              out: one part must be on the court's account before you may bid at
              all, and the rest falls due inside a deadline that forfeits the
              first part if you miss it.
            */}
            <dl class="mt-4 flex flex-col">
              <div class="flex items-baseline justify-between gap-3 border-b border-rule py-2">
                <dt class="text-[0.8125rem] font-semibold leading-snug">
                  Prije ročišta - kapara
                  <span class="ml-1 font-normal text-[0.71875rem] text-dim">
                    {dep ? `(${PROVENANCE_LABEL[dep.from]})` : '(nije navedena, ni izračunljiva)'}
                  </span>
                </dt>
                <dd id="cost-deposit" class="shrink-0 font-mono text-[0.8125rem] font-bold tabular-nums"></dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 border-b border-hair py-2">
                <dt class="text-[0.8125rem] leading-snug">
                  Doplata cijene
                  <span class="ml-1 text-[0.71875rem] text-dim">
                    (u roku do {PAYMENT_DEADLINE_DAYS} dana)
                  </span>
                </dt>
                <dd id="cost-balance" class="shrink-0 font-mono text-[0.8125rem] tabular-nums"></dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 border-b border-hair py-2">
                <dt id="cost-tax-row" class="text-[0.8125rem] leading-snug">Porez na promet</dt>
                <dd id="cost-tax-out" class="shrink-0 font-mono text-[0.8125rem] tabular-nums"></dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 border-b border-hair py-2">
                <dt class="text-[0.8125rem] leading-snug">
                  Takse, upis i papirologija
                  <span class="ml-1 text-[0.71875rem] text-dim">(procjena)</span>
                </dt>
                <dd id="cost-fees-out" class="shrink-0 font-mono text-[0.8125rem] tabular-nums"></dd>
              </div>
              <div
                id="cost-other-row"
                hidden
                class="flex items-baseline justify-between gap-3 border-b border-hair py-2"
              >
                <dt class="text-[0.8125rem] leading-snug">
                  Ostalo
                  <span class="ml-1 text-[0.71875rem] text-dim">(vaša procjena)</span>
                </dt>
                <dd id="cost-other-out" class="shrink-0 font-mono text-[0.8125rem] tabular-nums"></dd>
              </div>
              <div class="flex items-baseline justify-between gap-3 border-t border-rule pt-2.5">
                <dt class="text-[0.875rem] font-semibold leading-snug">Ukupno</dt>
                <dd id="cost-total" class="shrink-0 font-mono text-[1.0625rem] tracking-num font-bold tabular-nums"></dd>
              </div>
            </dl>

            <p class="mt-3 max-w-[72ch] text-[0.75rem] leading-relaxed text-muted">
              {tax.note}
            </p>
            <p class="mt-2 max-w-[72ch] text-[0.75rem] leading-relaxed text-muted">
              Kapara nije dodatni trošak - uračunava se u cijenu, a vraća vam se ako ne budete
              najpovoljniji ponuđač.{' '}
              {dep?.from === 'zakon' &&
                'Oglas je ne navodi, pa je ovdje izračunata po zakonu: desetina procijenjene vrijednosti, najviše 10.000 KM. '}
              Ako pobijedite pa ne uplatite u roku, prodaja se proglašava nevaljanom i kapara se ne
              vraća. Takse su naša procjena, ne tarifa - sudske takse su kantonalne i skaliraju s
              vrijednošću. Ne plaćate {NOT_PAYABLE.join('; ni ')}.
            </p>
          </div>
        </section>

        {/*
          The figures above are the ones that can be computed. These are the ones
          that decide whether the purchase was a good idea, and no notice states
          any of them - so they are named rather than guessed at, and the "Ostalo"
          field above is where a bidder puts their own number.
        */}
        {
          unpriced.length > 0 && (
            <section class="mt-7 border border-rule bg-blank" data-pagefind-ignore>
              <h2 class="flex items-center gap-2 border-b border-rule bg-band px-[18px] py-3.5 text-[0.8125rem] font-semibold leading-none">
