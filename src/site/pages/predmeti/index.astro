---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { itemCategoryGroups, itemCategories } from '../../lib/data.ts';
import { tagGroupIcon } from '../../lib/icons.ts';
---

<Base
  title="Pregled po predmetima - šta se prodaje na sudskim prodajama"
  description="Pretražite sudske prodaje po tome šta se zapravo prodaje: monitori, računari, traktori, vozila, namještaj, stanovi i zemljišta."
>
  <div class="gut border-b border-rule pb-[22px] pt-[30px]">
    <nav class="mb-3 font-mono text-[0.6875rem] leading-none text-dim">
      <a href="/" class="hover:text-ink">AKTUELNE</a> / ŠTA SE PRODAJE
    </nav>
    <h1 class="font-serif text-[2rem] leading-title tracking-title sm:text-[2.5rem] sm:leading-display sm:tracking-display">Šta se prodaje</h1>
    <p class="mt-3 max-w-[62ch] text-[0.875rem] leading-relaxed text-muted">
      {itemCategories.length} kategorija izvedenih iz teksta oglasa, grupisanih u {itemCategoryGroups.length}{' '}
      porodica. Prvi broj je koliko je otvoreno sada, drugi koliko ih ima u cijeloj arhivi.
    </p>
  </div>

  <!-- Cells carry their own right/bottom rule so a short last row leaves no stray filled cell. -->
  <div class="grid border-rule sm:grid-cols-2 lg:grid-cols-3">
    {
      itemCategoryGroups.map((g) => (
        <section class="border-b border-rule px-[22px] py-5 sm:border-r">
          <h2 class="flex items-center gap-1.5 border-b border-rule pb-[9px] text-[0.75rem] font-semibold uppercase leading-none tracking-label">
            <Icon name={tagGroupIcon(g.group)} size={15} class="text-pine" />
            {g.group}
          </h2>
          <div class="mt-1.5 flex flex-col">
            {g.tags.map((t) => (
              <a
                href={`/predmeti/${t.id}/`}
                class:list={[
                  'flex items-baseline justify-between gap-3 border-b border-hair py-2 text-[0.8125rem] font-medium leading-snug press last:border-0 hover:text-pine',
                  t.upcoming === 0 && 'text-dim',
                ]}
              >
                <span>{t.label}</span>
                <span class="whitespace-nowrap font-mono text-[0.71875rem] font-normal text-dim">
                  {t.upcoming > 0 ? <b class="text-pine">{t.upcoming}</b> : '0'} / {t.count}
                </span>
              </a>
            ))}
          </div>
        </section>
      ))
    }
  </div>

  <p class="gut border-t border-rule bg-band py-[18px] text-[0.78125rem] leading-relaxed text-muted">
    Kategorije bez otvorenih ročišta nisu prazne - vode u arhivu, gdje su prodaje iste vrste korisne
    za procjenu cijene.
  </p>
</Base>
