---
interface Props {
  /** localStorage key. Nothing leaves the browser, so no account is involved. */
  storeKey: string;
  label: string;
  activeLabel: string;
}
const { storeKey, label, activeLabel } = Astro.props;
---

<button
  type="button"
  data-store={storeKey}
  data-label={label}
  data-active-label={activeLabel}
  class="border border-ink bg-ink px-3 py-2.5 text-[12px] font-semibold leading-none text-white aria-pressed:border-edge aria-pressed:bg-transparent aria-pressed:text-ink"
  aria-pressed="false"
>
  {label}
</button>

<script>
  // Saved items live in the visitor's own browser: no account, no cookie, and
  // nothing sent anywhere. Reading it back is the only reason the key exists.
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-store]')) {
    const key = button.dataset.store!;

    const render = (on: boolean) => {
      button.setAttribute('aria-pressed', String(on));
      button.textContent = on ? button.dataset.activeLabel! : button.dataset.label!;
    };

    let saved = false;
    try {
      saved = localStorage.getItem(key) !== null;
    } catch {
      // Storage can be blocked outright; the button then just does nothing.
      button.hidden = true;
      continue;
    }
    render(saved);

    button.addEventListener('click', () => {
      saved = !saved;
      if (saved) localStorage.setItem(key, new Date().toISOString());
      else localStorage.removeItem(key);
      render(saved);
    });
  }
</script>
