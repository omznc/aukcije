---
import { iconBody } from '../lib/icons.ts';

interface Props {
  /** Phosphor name without the weight suffix, e.g. `gavel` or `map-pin`. */
  name: string;
  /** Pixels. The type scale here is small, so most icons want 14-18. */
  size?: number;
  class?: string;
  /** Set when the icon is the only thing carrying the meaning. */
  label?: string;
}
const { name, size = 16, class: className, label } = Astro.props;
---

<svg
  viewBox="0 0 256 256"
  width={size}
  height={size}
  fill="currentColor"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  class:list={['inline-block shrink-0 align-[-0.15em]', className]}
  set:html={iconBody(name)}
/>
