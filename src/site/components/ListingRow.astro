---
import type { Listing } from '../../schema.ts';
import Icon from './Icon.astro';
import { formatMoney, daysUntil } from '../lib/data.ts';
import { headline } from '../lib/headline.ts';
import { saleTypeIcon } from '../lib/icons.ts';
import { metaLine, discount, formatPercent, urgency, daysLabel } from '../lib/stats.ts';

interface Props {
  listing: Listing;
  /** Off on a court's own page, where every row names the same court. */
  showCourt?: boolean;
  /** The home table draws the discount as a bar as well as a number. */
  bar?: boolean;
  attrs?: Record<string, string>;
}
const { listing: l, showCourt = true, bar = false, attrs = {} } = Astro.props;

const days = daysUntil(l.saleDate);
const off = discount(l);

const URGENCY_COLOR = {
  due: 'text-brick',
  soon: 'text-rust',
  later: 'text-ink-mid',
  past: 'text-dim',
} as const;
---

<a
  href={`/oglas/${l.id}/`}
  {...attrs}
  class:list={[
    // A row is too wide to scale under the finger without looking like a
    // glitch, so it acknowledges the press with colour alone.
    'press grid grid-cols-[70px_1fr] items-start gap-x-4 gap-y-2 border-b border-hair py-3.5 hover:bg-wash active:bg-wash-deep md:items-center md:gap-y-0',
    'gut',
    showCourt
      ? 'md:grid-cols-[88px_1fr_160px_120px_120px_132px]'
      : 'md:grid-cols-[88px_1fr_120px_120px_132px]',
  ]}
>
  <div>
    <div class:list={['font-mono text-[0.78125rem] font-bold leading-none', URGENCY_COLOR[urgency(days)]]}>
      {daysLabel(days)}
    </div>
    <div class="mt-1 font-mono text-[0.65625rem] leading-none text-faint">
      {l.saleDate.slice(8, 10)}.{l.saleDate.slice(5, 7)}.
    </div>
  </div>

  <div class="md:pr-5">
    <div class="text-[0.875rem] font-semibold leading-snug">{headline(l)}</div>
    <!-- The meta line opens with the sale type, so the icon reads as its marker. -->
    <div class="mt-[3px] text-[0.71875rem] leading-snug text-dim">
      <Icon name={saleTypeIcon(l.saleType)} size={13} class="mr-1 text-faint" />
      {metaLine(l)}
    </div>
  </div>

  {
    showCourt && (
      <div class="col-start-2 text-[0.71875rem] leading-snug text-ink-mid md:col-start-auto md:pr-3">
        {l.court}{' '}
        <span class="whitespace-nowrap border border-edge px-1 py-0.5 font-mono text-[0.59375rem] font-medium leading-none">
          {l.entity}
        </span>
      </div>
    )
  }

  <div
    class="col-start-2 flex flex-wrap items-baseline gap-x-4 md:col-start-auto md:contents"
  >
    <span class="font-mono text-[0.8125rem] leading-none text-dim md:text-right">
      {formatMoney(l.appraisedValue) ?? '-'}
    </span>
    <span class="font-mono text-[0.875rem] font-bold leading-none md:text-right">
      {formatMoney(l.startingPrice) ?? <span class="font-normal text-ghost">-</span>}
    </span>
    <span class="md:text-right">
      <span
        class:list={[
          'font-mono text-[0.8125rem] font-bold leading-none',
          off === null ? 'text-ghost' : off > 0 ? 'text-pine' : 'text-dim',
        ]}
      >
        {off === null ? 'nema početne' : formatPercent(off)}
      </span>
      {
        bar && (
          <span class="mt-1.5 hidden h-1 bg-track md:block">
            <span
              class="ml-auto block h-1 bg-pine"
              style={`width:${Math.max(0, Math.min(100, Math.round((off ?? 0) * 100)))}%`}
            />
          </span>
        )
      }
    </span>
  </div>
</a>
