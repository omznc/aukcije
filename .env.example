# Public URL this build is for. Baked into canonical tags, RSS, the sitemap and
# llms.txt, so a stale value silently publishes wrong URLs. Only needs setting
# when building for somewhere other than the production domain.
# SITE_URL=https://sudskeprodaje.omarzunic.com

# Optional: enables the LLM pass that fills fields the regex rules could not.
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides.
# Any OpenRouter model id. The default is a cheap, fast one that handles
# Bosnian/Croatian/Serbian well.
LLM_MODEL=google/gemini-2.5-flash-lite
# Hard cap on calls per run, so a bad run cannot quietly spend money.
LLM_MAX_CALLS=400
LLM_CONCURRENCY=4

# Scanned-PDF transcription. Defaults to LLM_MODEL with OpenRouter's
# `mistral-ocr` engine, which reads image-only pages; `pdf-text` only lifts an
# existing text layer and is useless for scans.
# OCR_MODEL=google/gemini-2.5-flash-lite
# OCR_ENGINE=mistral-ocr
